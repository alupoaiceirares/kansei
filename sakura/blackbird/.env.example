# Copy this file to .env locally and fill in real values, .env itself is gitignored, only this .example file is committed
# Required, where control-tower is reachable
CONTROL_TOWER_URL=
# Required, northstar's origin, the auth bridge bounces here when there is no token
NORTHSTAR_URL=
# Required, soundwave's origin, the footer Wirehood pill points here
SOUNDWAVE_URL=
