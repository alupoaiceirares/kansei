# Copy this file to .env locally and fill in real values as the .env itself is gitignored - only this .example file is committed.
# Must match DB_USERNAME/DB_PASSWORD in the repo-root .env (that's what actually configures the compose Postgres container's login - postgres/postgres is disabled on purpose)
# DB_PORT: optional, defaults to 5433 (docker-compose Postgres). Set to 5432 + a native install's own credentials to point there instead
DB_PORT=
DB_USERNAME=
DB_PASSWORD=

# Secret is expected base64-encoded
JWT_SECRET=

# RabbitMQ - shieldwall only publishes mail.events here; the courier-one service consumes and actually sends the email.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Optional - defaults to http://localhost:3000 (no frontend exists yet)
# FRONTEND_URL=
