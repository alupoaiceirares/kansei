# Copy this file to .env locally and fill in real values as the .env itself is gitignored - only this .example file is committed.
# Must match SHIELDWALL_DB_USERNAME/SHIELDWALL_DB_PASSWORD/SHIELDWALL_DB_NAME in the repo-root .env (that's what actually configures the compose Postgres container's login/database - postgres/postgres is disabled on purpose)
# Required
SERVER_PORT=

# Required - localhost for mvn/IntelliJ, overridden by docker-compose.yml if this app runs containerized
DB_HOST=

# DB_PORT: required - depends on whether you're pointing at the docker-compose Postgres or a native install, see .env for the two options
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Secret is expected base64-encoded
JWT_SECRET=

# RabbitMQ - shieldwall only publishes mail.events here; the courier-one service consumes and actually sends the email.
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Required - no frontend exists yet, this is just where verification/reset links point
FRONTEND_URL=

# Shared secret for service-to-service calls to /api/internal/** - must match INTERNAL_SERVICE_SECRET in every service that calls it
INTERNAL_SERVICE_SECRET=

# Same shared Redis instance as wirehood/control-tower
# Authenticates as the "shieldwall" ACL user (~shieldwall:* only), not the default/full-access user, value must match SHIELDWALL_REDIS_PASSWORD in the repo-root .env, not the repo-root REDIS_PASSWORD (that's the default user's password now)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
