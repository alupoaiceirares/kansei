# Copy this file to .env locally and fill in real values as the .env itself is gitignored - only this .example file is committed
# Required
SERVER_PORT=

# Required - localhost for mvn/IntelliJ, overridden by docker-compose.yml once this app gets its own container
DB_HOST=

# DB_PORT: required - depends on whether you're pointing at a docker Postgres or a native install, see .env for the two options
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# RabbitMQ - same broker shieldwall/courier-one use, must match RABBITMQ_USER/PASSWORD in the repo-root .env
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Required - absolute path on this machine where downloaded audio/thumbnail files are written
STORAGE_ROOT=

# Redis - SSE ticket storage (single-use, short TTL).
# Same shared instance planned for credentials_version cache/rankings later. Must match REDIS_PASSWORD/REDIS_PORT in the repo-root .env
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Service-to-service call to shieldwall's internal id-to-username lookup - never routed through control-tower
# URI is shieldwall's own host:port. Secret must match INTERNAL_SERVICE_SECRET in services/shieldwall/.env exactly
SHIELDWALL_INTERNAL_URI=
INTERNAL_SERVICE_SECRET=
