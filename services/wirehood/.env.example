# Copy this file to .env locally and fill in real values as the .env itself is gitignored - only this .example file is committed
# Required
SERVER_PORT=

# Required - localhost for mvn/IntelliJ, overridden by docker-compose.yml once this app gets its own container
DB_HOST=

# DB_PORT: required - depends on whether you're pointing at a docker Postgres or a native install, see .env for the two options
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
