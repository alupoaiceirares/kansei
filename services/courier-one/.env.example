# Copy this file to .env locally and fill in real values as the .env itself is gitignored - only this .example file is committed.

# RabbitMQ - same broker shieldwall publishes to. Must match RABBITMQ_USER/RABBITMQ_PASSWORD in the repo-root .env. RABBITMQ_HOST is overridden to the container hostname by docker-compose.yml when run via `docker compose up`.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# SMTP (Resend)
RESEND_SMTP_HOST=
RESEND_SMTP_PORT=
RESEND_SMTP_USER=
RESEND_SMTP_PASS=
MAIL_FROM=
