<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Reset your password — The Kansei Project</title>
<style>
  @media only screen and (max-width: 620px) {
    .kx-wrap { width: 100% !important; }
    .kx-pad { padding-left: 24px !important; padding-right: 24px !important; }
    .kx-h1 { font-size: 26px !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background-color:#f4f1ec;">

<span style="display:none!important;visibility:hidden;opacity:0;color:transparent;height:0;width:0;overflow:hidden;mso-hide:all;">Reset your Kansei password. Link valid 1 hour.</span>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#f4f1ec;">
<tr>
<td align="center" style="padding:32px 12px 48px 12px;">

  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" class="kx-wrap" style="width:600px;max-width:600px;background-color:#ffffff;border-radius:16px;border:1px solid #e6e0d8;">

    <!-- gradient band -->
    <tr>
      <td width="600" style="width:600px;height:8px;line-height:8px;font-size:0;background-color:#2f7f97;background-image:linear-gradient(90deg,#2f7f97 0%,#2f7f97 24%,#a53125 38%,#d54b96 52%,#c08a1e 64%,#276b4e 76%,#276b4e 100%);border-radius:16px 16px 0 0;">&nbsp;</td>
    </tr>

    <!-- brand -->
    <tr>
      <td align="center" class="kx-pad" style="padding:36px 48px 0 48px;font-family:Georgia,'Times New Roman',serif;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 18px auto;">
          <tr>
            <td width="10" height="10" style="width:10px;height:10px;line-height:10px;font-size:0;background-color:#2f7f97;border-radius:5px;">&nbsp;</td>
            <td width="8" style="width:8px;font-size:0;line-height:10px;">&#8203;</td>
            <td width="10" height="10" style="width:10px;height:10px;line-height:10px;font-size:0;background-color:#a53125;border-radius:5px;">&nbsp;</td>
            <td width="8" style="width:8px;font-size:0;line-height:10px;">&#8203;</td>
            <td width="10" height="10" style="width:10px;height:10px;line-height:10px;font-size:0;background-color:#d54b96;border-radius:5px;">&nbsp;</td>
            <td width="8" style="width:8px;font-size:0;line-height:10px;">&#8203;</td>
            <td width="10" height="10" style="width:10px;height:10px;line-height:10px;font-size:0;background-color:#c08a1e;border-radius:5px;">&nbsp;</td>
            <td width="8" style="width:8px;font-size:0;line-height:10px;">&#8203;</td>
            <td width="10" height="10" style="width:10px;height:10px;line-height:10px;font-size:0;background-color:#276b4e;border-radius:5px;">&nbsp;</td>
          </tr>
        </table>
        <div style="font-family:Georgia,'Times New Roman',serif;font-size:19px;line-height:24px;mso-line-height-rule:exactly;color:#2b2724;letter-spacing:0.4px;">The Kansei Project</div>
      </td>
    </tr>

    <!-- heading + copy -->
    <tr>
      <td align="center" class="kx-pad" style="padding:30px 56px 0 56px;">
        <div class="kx-h1" style="font-family:Georgia,'Times New Roman',serif;font-size:30px;line-height:38px;mso-line-height-rule:exactly;color:#2b2724;">Reset your password</div>
        <div style="height:16px;line-height:16px;font-size:0;">&nbsp;</div>
        <div style="font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:26px;mso-line-height-rule:exactly;color:#5f5a54;">
          Hi {{username}}, we received a request to reset your Kansei password. Use the button below to choose a new one.
        </div>
      </td>
    </tr>

    <!-- button -->
    <tr>
      <td align="center" class="kx-pad" style="padding:32px 56px 0 56px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td align="center" bgcolor="#a3357c" style="border-radius:999px;">
              <a href="{{link}}" style="display:block;padding:15px 40px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;line-height:20px;mso-line-height-rule:exactly;color:#ffffff;text-decoration:none;border-radius:999px;">Reset my password</a>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <tr>
      <td align="center" class="kx-pad" style="padding:22px 56px 0 56px;">
        <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:22px;mso-line-height-rule:exactly;color:#8a837b;">
          This link is valid for 1 hour. If it expires, you can request a new one from the log-in page.
        </div>
      </td>
    </tr>

    <!-- fallback url -->
    <tr>
      <td class="kx-pad" style="padding:28px 56px 0 56px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;background-color:#f7f4ef;border:1px solid #e6e0d8;border-radius:12px;">
          <tr>
            <td style="padding:16px 18px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:20px;mso-line-height-rule:exactly;color:#6b655e;word-break:break-all;">
              Button not working? Paste this into your browser:<br>
              <a href="{{link}}" style="color:#a3357c;text-decoration:underline;">{{link}}</a>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- divider -->
    <tr>
      <td class="kx-pad" style="padding:32px 56px 0 56px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;">
          <tr><td height="1" style="height:1px;line-height:1px;font-size:0;background-color:#e6e0d8;">&nbsp;</td></tr>
        </table>
      </td>
    </tr>

    <tr>
      <td align="center" class="kx-pad" style="padding:22px 56px 36px 56px;">
        <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:22px;mso-line-height-rule:exactly;color:#8a837b;">
          Didn't request this? You can safely ignore this email — your password won't change.
        </div>
      </td>
    </tr>

  </table>

  <!-- footer -->
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" class="kx-wrap" style="width:600px;max-width:600px;">
    <tr>
      <td align="center" class="kx-pad" style="padding:26px 48px 0 48px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:20px;mso-line-height-rule:exactly;color:#918a82;">
        The Kansei Project
      </td>
    </tr>
  </table>

</td>
</tr>
</table>

</body>
</html>
