# Copy this file to .env locally and fill in real values as the .env itself is gitignored - only this .example file is committed
# Required
SERVER_PORT=

# Required - path for the ECS-shaped JSON log file (mvn/IntelliJ: repo-relative logs/fdr/fdr.json)
LOG_FILE=

# Required - localhost for mvn/IntelliJ, overridden by docker-compose.yml if this app runs containerized
DB_HOST=

# DB_PORT: required - depends on whether you're pointing at the docker-compose Postgres or a native install
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# RabbitMQ - consumes audit.events. Must match RABBITMQ_USER/RABBITMQ_PASSWORD in the repo-root .env
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Required - how many days of audit_log rows to keep, AuditRetentionScheduler deletes anything older daily
FDR_AUDIT_RETENTION_DAYS=
