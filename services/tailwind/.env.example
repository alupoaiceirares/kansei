# Copy this file to .env locally and fill in real values as the .env itself is gitignored, only this .example file is committed.
# Required, no code-level fallback
SERVER_PORT=

# Required, path for the ECS-shaped JSON log file (mvn/IntelliJ: repo-relative logs/tailwind/tailwind.json)
LOG_FILE=

# DB_HOST: required. localhost for mvn/IntelliJ (native or docker-compose Postgres, both reach via a published port)
# Docker container value (docker-compose.yml overrides this automatically when run via the full profile): the postgres-tailwind service name
DB_HOST=

# DB_PORT: required, no code-level fallback (fail loudly instead of guessing)
# Run CREATE DATABASE for DB_NAME once against a native Postgres before starting the app, Liquibase creates tables, not the database itself
# Docker container value: the container-internal port, not the host-published TAILWIND_DB_PORT from the repo-root .env
DB_PORT=
# Docker container value: must match TAILWIND_DB_USERNAME in the repo-root .env
DB_USERNAME=
# Docker container value: must match TAILWIND_DB_PASSWORD in the repo-root .env
DB_PASSWORD=
DB_NAME=

# Redis, localhost for mvn/IntelliJ (docker-compose's redis container publishes to loopback)
# Docker container value: the redis service name
# Authenticates as the "tailwind" ACL user, value must match TAILWIND_REDIS_PASSWORD in the repo-root .env
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# shieldwall's own address, service-to-service call, never through control-tower
# Must match INTERNAL_SERVICE_SECRET in services/shieldwall/.env exactly
SHIELDWALL_INTERNAL_URI=
INTERNAL_SERVICE_SECRET=

# Local dev folder for aircraft photos, created automatically if missing
# Docker container value: the in-container storage path (bind-mounted to TAILWIND_STORAGE_HOST_DIR from the repo-root .env)
STORAGE_ROOT=

# AeroDataBox key from the API.Market dashboard, never logged, never sent to the frontend. Not used until the flight lookup phase
AERODATABOX_API_KEY=
