scalar Date

type Query {
    # Without userId this is the caller's own profile, with one it is that user's, narrowed to what the caller
    # may see. Fields are resolved lazily (TravelProfileController), so a small dashboard query and the full
    # stats page only pay for the fields they ask for.
    travelProfile(userId: ID, period: PeriodInput): TravelProfile!
}

# Both ends are optional and inclusive, on the flight's own local departure date.
input PeriodInput {
    from: Date
    to: Date
}

type TravelProfile {
    stats: TravelStats!
    countries: VisitedCountries!
    airports: [AirportVisit!]!
    aircraft: [AircraftFamilyCollection!]!
    # Every airliner family, flown or not, so the collection can show what is still missing
    aircraftCatalog: [AircraftFamilyOption!]!
    airlines: [AirlineCount!]!
    records: TravelRecords!
    breakdowns: TravelBreakdowns!
}

# Counts are distinct: 3 flights on the same A320 count once under aircraftTypes.
type TravelStats {
    flightCount: Int!
    distanceKm: Float!
    # Only flights that have both a departure and an arrival time, so it can cover fewer flights than flightCount
    timeInAirMinutes: Int!
    flightsWithDuration: Int!
    countryCount: Int!
    airportCount: Int!
    airlineCount: Int!
    aircraftFamilyCount: Int!
    aircraftTypeCount: Int!
    longestFlightKm: Float
    averageFlightKm: Float
    cargoFlightCount: Int!
}

# visited: countries the user was actually in (origin, final destination, STAY and LAYOVER_VISITED stops).
# passedThrough: countries only seen from a layover, listed separately so the map can style them differently.
type VisitedCountries {
    visited: [CountryVisit!]!
    passedThrough: [CountryVisit!]!
}

type CountryVisit {
    code: String!
    name: String!
    continent: String!
    visitCount: Int!
    firstVisit: Date!
    lastVisit: Date!
}

type AirportVisit {
    id: ID!
    icao: String
    iata: String
    name: String!
    city: String
    countryCode: String!
    latitude: Float!
    longitude: Float!
    timesUsed: Int!
    departures: Int!
    arrivals: Int!
    firstVisit: Date!
    lastVisit: Date!
}

# One card per family. variants holds what was actually flown, including the "variant unknown" entry
# for flights where only the family could be resolved.
type AircraftFamilyCollection {
    family: String!
    flightCount: Int!
    distanceKm: Float!
    firstFlight: Date!
    lastFlight: Date!
    photoUrl: String!
    variants: [AircraftVariantCount!]!
}

# aircraftTypeId and icaoCode are null for the "variant unknown" entry.
type AircraftVariantCount {
    aircraftTypeId: ID
    icaoCode: String
    name: String!
    manufacturer: String
    bodyType: String
    flightCount: Int!
    firstFlight: Date!
    lastFlight: Date!
    photoUrl: String
}

type AirlineCount {
    id: ID!
    icao: String!
    iata: String
    name: String!
    flightCount: Int!
    distanceKm: Float!
}

# flightCount is 0 for a family the user has never flown, which the collection shows as locked.
type AircraftFamilyOption {
    family: String!
    manufacturer: String
    bodyType: String
    variantCount: Int!
    flightCount: Int!
    photoUrl: String!
}

# Counts of what the user chose to record per flight. A flight left blank is not counted at all, so
# flightsWithCabin says how much of the log the cabin split actually covers.
type TravelBreakdowns {
    cabinClasses: [NamedCount!]!
    seatPositions: [NamedCount!]!
    reasons: [NamedCount!]!
    flightsPerYear: [PeriodCount!]!
    flightsWithCabin: Int!
    flightsWithReason: Int!
    flightsWithSeatPosition: Int!
}

# Every field is null until there is a flight to fill it.
type TravelRecords {
    longestFlight: FlightRecord
    shortestFlight: FlightRecord
    firstFlight: FlightRecord
    longestJourney: JourneyRecord
    mostFlownRoute: RouteRecord
    mostFlownAircraftFamily: NamedCount
    mostFlownAirline: NamedCount
    busiestMonth: PeriodCount
    biggestYear: PeriodCount
    furthestPoint: FurthestPoint
    longestGap: LongestGap
    mostAircraftInAJourney: JourneyAircraftRecord
    highestCabin: CabinRecord
}

# The airport furthest from home, where home is the airport the user passes through most.
type FurthestPoint {
    iata: String
    name: String!
    city: String
    countryCode: String!
    distanceFromHomeKm: Float!
    homeIata: String
    date: Date!
}

# The longest stretch with no flying, measured between two flights in the log.
type LongestGap {
    days: Int!
    from: Date!
    to: Date!
}

type JourneyAircraftRecord {
    journeyId: ID!
    title: String!
    aircraftCount: Int!
    flightCount: Int!
}

type CabinRecord {
    cabinClass: String!
    flightCount: Int!
    firstFlight: Date!
}

type FlightRecord {
    userFlightId: ID!
    flightNumber: String
    date: Date!
    distanceKm: Float!
    departureIata: String
    arrivalIata: String
    airlineName: String!
    aircraftName: String
}

type JourneyRecord {
    journeyId: ID!
    title: String!
    flightCount: Int!
    distanceKm: Float!
    startDate: Date!
    endDate: Date!
}

type RouteRecord {
    departureIata: String
    arrivalIata: String
    departureName: String!
    arrivalName: String!
    flightCount: Int!
    distanceKm: Float!
}

type NamedCount {
    name: String!
    count: Int!
}

# label is the month (2026-09) or the year (2026).
type PeriodCount {
    label: String!
    count: Int!
    distanceKm: Float!
}
