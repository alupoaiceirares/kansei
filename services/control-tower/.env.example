# Copy this file to .env locally and fill in real values as the .env itself is gitignored - only this .example file is committed
# Must match JWT_SECRET in services/shieldwall/.env - control-tower verifies signatures with the same key shieldwall signs with, it never issues tokens itself
# Required
SERVER_PORT=

# Secret is expected base64-encoded
JWT_SECRET=

# Required - where shieldwall/wirehood are reachable
SHIELDWALL_URI=
WIREHOOD_URI=

# Required - comma-separated frontend origins allowed to call this gateway from browser JS
CORS_ALLOWED_ORIGINS=

# Same shared Redis instance
# Authenticates as the "control-tower" ACL user, not the default/full-access user, value must match CONTROL_TOWER_REDIS_PASSWORD in the repo-root .env, not the repo-root REDIS_PASSWORD
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
