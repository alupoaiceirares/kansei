# Copy this file to .env locally and fill in real values.
# .env itself is gitignored - only this .example file is committed.

DB_USERNAME=
DB_PASSWORD=

# Secret is expected base64-encoded
JWT_SECRET=

# SMTP (Resend) - host/port/user are fixed, not secret. Only RESEND_SMTP_PASS
# (the Resend API key) needs a real value per environment.
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_SMTP_USER=resend
RESEND_SMTP_PASS=
MAIL_FROM=noreply@projectkansei.com

# Optional - defaults to http://localhost:3000 (no frontend exists yet)
# FRONTEND_URL=
