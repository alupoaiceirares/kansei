# Copy this file to .env locally and fill in real values.
# .env itself is gitignored - only this .example file is committed.

DB_USERNAME=
DB_PASSWORD=

# Secret is expected base64-encoded
JWT_SECRET=

# RabbitMQ - auth-service only publishes mail.events here; the courier-one service consumes and actually sends the email.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# Must match RABBITMQ_USER/RABBITMQ_PASSWORD in the repo-root .env (that's what actually
# configures the RabbitMQ container's login - guest/guest is disabled here on purpose).
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Optional - defaults to http://localhost:3000 (no frontend exists yet)
# FRONTEND_URL=
