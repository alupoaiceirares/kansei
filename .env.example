# Copy this file to .env locally and fill in real values as the .env itself is gitignored
# Read by docker-compose.yml to set the RabbitMQ container's own admin login (management UI +
# rabbitmq-init) - no service authenticates as this one, see the per-service RABBITMQ_*_PASSWORD
# vars below and infra/rabbitmq/init-users.sh
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Host-side published ports, must match RABBITMQ_PORT in services/shieldwall/.env and services/courier-one/.env
RABBITMQ_PORT=
RABBITMQ_MANAGEMENT_PORT=

# One scoped RabbitMQ user per service, provisioned by rabbitmq-init/infra/rabbitmq/init-users.sh
# (regex permissions per service, see that script). Username is the literal service name in each
# case, not env-driven. Must match RABBITMQ_USERNAME/RABBITMQ_PASSWORD in that service's own .env
SHIELDWALL_RABBITMQ_PASSWORD=
WIREHOOD_RABBITMQ_PASSWORD=
COURIER_ONE_RABBITMQ_PASSWORD=
FDR_RABBITMQ_PASSWORD=

# Read by docker-compose.yml to set shieldwall's Postgres container login/database, must match DB_USERNAME/DB_PASSWORD/DB_NAME in services/shieldwall/.env. Prefixed (not just DB_*) since each service that gets its own DB adds its own set here later, no collisions
SHIELDWALL_DB_USERNAME=
SHIELDWALL_DB_PASSWORD=
SHIELDWALL_DB_NAME=

# Host-side published port - must match DB_PORT in services/shieldwall/.env
SHIELDWALL_DB_PORT=

# Used for both sides of the shieldwall container's port mapping, must match SERVER_PORT in services/shieldwall/.env
SHIELDWALL_PORT=

# Used for both sides of the control-tower container's port mapping, must match SERVER_PORT in services/control-tower/.env
CONTROL_TOWER_PORT=

# Read by docker-compose.yml to set the Redis container's default-user auth password, full access, used for redis-cli/manual debugging and the container healthcheck only
# No app service authenticates as default anymore (see the three ACL passwords below); must still match REDIS_PASSWORD in every service's own .env for the healthcheck story to make sense, but services connect as their own user now
REDIS_PASSWORD=

# Host-side published port, bound to 127.0.0.1 only (not exposed the machine is working on), must match REDIS_PORT in every service's own .env
REDIS_PORT=

# Per-service Redis ACL user passwords (docker-compose.yml's redis service defines these users, scoped to their own key prefix, see ACL rules)
# Each must match REDIS_PASSWORD in the matching service's own .env (services/shieldwall/.env, services/control-tower/.env, services/wirehood/.env)
SHIELDWALL_REDIS_PASSWORD=
CONTROL_TOWER_REDIS_PASSWORD=
WIREHOOD_REDIS_PASSWORD=

# Read by docker-compose.yml to set wirehood's Postgres container login/database, must match DB_USERNAME/DB_PASSWORD/DB_NAME in services/wirehood/.env
WIREHOOD_DB_USERNAME=
WIREHOOD_DB_PASSWORD=
WIREHOOD_DB_NAME=

# Host-side published port, must match DB_PORT in services/wirehood/.env
WIREHOOD_DB_PORT=

# Used for both sides of the wirehood container's port mapping, must match SERVER_PORT in services/wirehood/.env
WIREHOOD_PORT=

# Host absolute path bind-mounted into the wirehood container for downloaded tracks/thumbnails, a real folder on this machine, survives container recreate/`docker-compose down -v`
WIREHOOD_STORAGE_HOST_DIR=

# Grafana admin login (GF_SECURITY_ADMIN_USER/PASSWORD) and its host-published port - must not be 3000 (northstar) or 4200 (soundwave)
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=

# Read by docker-compose.yml to set fdr's Postgres container login/database, must match DB_USERNAME/DB_PASSWORD/DB_NAME in services/fdr/.env
FDR_DB_USERNAME=
FDR_DB_PASSWORD=
FDR_DB_NAME=

# Host-side published port, must match DB_PORT in services/fdr/.env
FDR_DB_PORT=

# Password for the read-only grafana_reader Postgres role, created once by infra/postgres-fdr/init/01-grafana-reader.sh - Grafana's fdr-audit datasource connects with this
FDR_GRAFANA_DB_PASSWORD=

# Used for both sides of the fdr container's port mapping, must match SERVER_PORT in services/fdr/.env
FDR_PORT=
