# Copy this file to .env locally and fill in real values as the .env itself is gitignored - only this .example file is committed
# Read by docker-compose.yml to set the RabbitMQ container's own login - must match RABBITMQ_USERNAME/RABBITMQ_PASSWORD in services/shieldwall/.env and services/courier-one/.env
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Host-side published ports - must match RABBITMQ_PORT in services/shieldwall/.env and services/courier-one/.env
RABBITMQ_PORT=
RABBITMQ_MANAGEMENT_PORT=

# Read by docker-compose.yml to set shieldwall's Postgres container login/database - must match DB_USERNAME/DB_PASSWORD/DB_NAME in services/shieldwall/.env. Prefixed (not just DB_*) since each service that gets its own DB adds its own set here later, no collisions
SHIELDWALL_DB_USERNAME=
SHIELDWALL_DB_PASSWORD=
SHIELDWALL_DB_NAME=

# Host-side published port - must match DB_PORT in services/shieldwall/.env
SHIELDWALL_DB_PORT=

# Used for both sides of the shieldwall container's port mapping - must match SERVER_PORT in services/shieldwall/.env
SHIELDWALL_PORT=

# Used for both sides of the control-tower container's port mapping - must match SERVER_PORT in services/control-tower/.env
CONTROL_TOWER_PORT=

# Read by docker-compose.yml to set the Redis container's auth password - must match REDIS_PASSWORD in services/wirehood/.env (and any other service that connects to Redis later)
REDIS_PASSWORD=

# Host-side published port, bound to 127.0.0.1 only (not exposed the machine is working on) - must match REDIS_PORT in services/wirehood/.env
REDIS_PORT=
